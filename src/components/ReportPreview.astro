---
<section id="reportPreviewPanel" class="panel" aria-labelledby="reportPreviewHeading" hidden>
  <div class="preview-panel-header">
    <div>
      <h2 id="reportPreviewHeading">Report preview</h2>
      <p class="section-lead">Review officer metadata and all six narratives in reading order. Highlighted terms mark possible acronyms to check against the AFPC list; plain-text copying preserves your original wording without markup.</p>
    </div>
    <div class="preview-panel-actions">
      <button id="previewCopyFullBtn" type="button" class="secondary">Copy Full Draft</button>
      <button id="previewPrintBtn" type="button" class="secondary">Print / Save PDF</button>
    </div>
  </div>

  <dl id="previewMetadata" class="preview-meta-card"></dl>
  <div id="sectionPreviews"></div>
</section>
